@baseUrl = http://localhost:3000
@customerEmail = customer@example.com
@adminEmail = admin@example.com
@password = password123

### Register customer
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "{{password}}"
}

### Register admin (role assignment is enabled for this practical's local testing)
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}",
  "role": "admin"
}

### Login customer
# @name customerLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{customerEmail}}",
  "password": "{{password}}"
}

### Login admin
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "{{adminEmail}}",
  "password": "{{password}}"
}

### Current customer
GET {{baseUrl}}/auth/me
Authorization: Bearer {{customerLogin.response.body.$.access_token}}

### Public clothing catalog
GET {{baseUrl}}/clothing

### Customer cannot create clothing (expected 403 Forbidden)
POST {{baseUrl}}/clothing
Authorization: Bearer {{customerLogin.response.body.$.access_token}}
Content-Type: application/json

{
  "title": "T-shirt",
  "price": 25.99,
  "size": "M",
  "color": "black"
}

### Admin creates clothing (expected 201 Created)
# @name createClothing
POST {{baseUrl}}/clothing
Authorization: Bearer {{adminLogin.response.body.$.access_token}}
Content-Type: application/json

{
  "title": "T-shirt",
  "price": 25.99,
  "size": "M",
  "color": "black"
}

### Admin deletes created clothing (expected 200 OK)
DELETE {{baseUrl}}/clothing/{{createClothing.response.body.$.id}}
Authorization: Bearer {{adminLogin.response.body.$.access_token}}
